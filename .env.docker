# =============================================================================
# Posthive — Docker self-host configuration
# =============================================================================
# Copy this file to .env, fill in the required values, then run:
#   docker compose up -d --build
#
# Required fields are uncommented. Everything else is optional — uncomment
# only what you need. Redis and Postgres connection strings are set
# automatically by Docker Compose; do not set them here.
# =============================================================================

# -----------------------------------------------------------------------------
# Required
# -----------------------------------------------------------------------------

POSTGRES_PASSWORD=change_me_to_a_strong_password

# Generate each secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_64_char_hex
JWT_REFRESH_SECRET=replace_with_64_char_hex

# WARNING: never change ENCRYPTION_KEY after accounts are saved.
# All stored OAuth tokens will become permanently unreadable.
ENCRYPTION_KEY=replace_with_64_char_hex

# Public URLs — must match your domain. Baked into the Next.js build.
# Rebuild required (docker compose up -d --build) if you change these.
WEB_URL=https://yourdomain.com
PUBLIC_API_URL=https://api.yourdomain.com

PORT=3001
AUTH_PROVIDER=local

# Set to "true" in production (HTTPS only cookies)
SECURE_COOKIES=true

# -----------------------------------------------------------------------------
# Email — password reset + email verification (Resend)
# Sign up at https://resend.com, verify your domain, create an API key.
# Without this, password reset links are logged to the API console only.
# -----------------------------------------------------------------------------
# RESEND_API_KEY=re_...
# EMAIL_FROM=Posthive <noreply@yourdomain.com>

# -----------------------------------------------------------------------------
# Storage — where uploaded media files are saved
# "local" stores files inside the container (lost on rebuild — see docs).
# "supabase" stores files in Supabase Storage (survives rebuilds).
# -----------------------------------------------------------------------------
# STORAGE_PROVIDER=local

# Supabase Storage — only when STORAGE_PROVIDER=supabase
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_STORAGE_BUCKET=media

# -----------------------------------------------------------------------------
# Admin panel (/admin) — leave blank to disable
# -----------------------------------------------------------------------------
# ADMIN_EMAIL=you@yourdomain.com
# ADMIN_PIN=your-pin
# BULL_BOARD_TOKEN=your-bearer-token

# -----------------------------------------------------------------------------
# Analytics — visitor session tracking (disabled for self-hosters by default)
# -----------------------------------------------------------------------------
# ENABLE_ANALYTICS=false

# -----------------------------------------------------------------------------
# Error monitoring — Sentry
# -----------------------------------------------------------------------------
# SENTRY_DSN=https://your-dsn@sentry.io/project-id

# =============================================================================
# Platform OAuth — uncomment only the platforms you want to enable.
# Redirect URI pattern: https://api.yourdomain.com/auth/<platform>/callback
#
# No setup needed: Bluesky, Mastodon, Pixelfed, Telegram, Nostr, Lemmy, Discord
# (users enter their own credentials when connecting)
# =============================================================================

# -----------------------------------------------------------------------------
# Google Sign-In (login / register with Google)
# https://console.cloud.google.com → Credentials → OAuth 2.0 Client ID
# -----------------------------------------------------------------------------
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-client-secret
# GOOGLE_REDIRECT_URI=https://api.yourdomain.com/auth/google/callback

# -----------------------------------------------------------------------------
# Threads
# https://developers.facebook.com → create app → add Threads use case
# -----------------------------------------------------------------------------
# THREADS_APP_ID=your-app-id
# THREADS_APP_SECRET=your-app-secret
# THREADS_REDIRECT_URI=https://api.yourdomain.com/auth/threads/callback

# -----------------------------------------------------------------------------
# Instagram
# Same Meta app as Threads — add the Instagram product
# Requires a Professional (Business or Creator) Instagram account
# -----------------------------------------------------------------------------
# INSTAGRAM_APP_ID=your-app-id
# INSTAGRAM_APP_SECRET=your-app-secret
# INSTAGRAM_REDIRECT_URI=https://api.yourdomain.com/auth/instagram/callback

# -----------------------------------------------------------------------------
# Facebook Pages
# Same Meta app as Threads/Instagram — add "Manage everything on your Page"
# -----------------------------------------------------------------------------
# FACEBOOK_APP_ID=your-app-id
# FACEBOOK_APP_SECRET=your-app-secret
# FACEBOOK_REDIRECT_URI=https://api.yourdomain.com/auth/facebook/callback

# -----------------------------------------------------------------------------
# LinkedIn
# https://developer.linkedin.com → create app
# Required products: "Share on LinkedIn" + "Sign In with LinkedIn using OpenID Connect"
# -----------------------------------------------------------------------------
# LINKEDIN_CLIENT_ID=your-client-id
# LINKEDIN_CLIENT_SECRET=your-client-secret
# LINKEDIN_REDIRECT_URI=https://api.yourdomain.com/auth/linkedin/callback

# -----------------------------------------------------------------------------
# YouTube
# https://console.cloud.google.com → enable YouTube Data API v3
# Use http://localhost:3001/auth/youtube/callback — Google blocks tunnel domains.
# Connect YouTube from a browser on the same machine as the API server.
# -----------------------------------------------------------------------------
# YOUTUBE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# YOUTUBE_CLIENT_SECRET=your-client-secret
# YOUTUBE_REDIRECT_URI=http://localhost:3001/auth/youtube/callback

# -----------------------------------------------------------------------------
# Pinterest
# https://developers.pinterest.com → create app
# Scopes: boards:read boards:write pins:read pins:write user_accounts:read
# Set PINTEREST_SANDBOX=true while your app has Trial access only
# -----------------------------------------------------------------------------
# PINTEREST_CLIENT_ID=your-app-id
# PINTEREST_CLIENT_SECRET=your-app-secret
# PINTEREST_REDIRECT_URI=https://api.yourdomain.com/auth/pinterest/callback
# PINTEREST_SANDBOX=false
# PINTEREST_SANDBOX_TOKEN=

# -----------------------------------------------------------------------------
# X / Twitter (Pro & Team plans only)
# https://developer.x.com → create app → enable OAuth 1.0a with Read+Write
# -----------------------------------------------------------------------------
# X_API_KEY=your-api-key
# X_API_SECRET=your-api-secret
# X_CALLBACK_URL=https://api.yourdomain.com/auth/twitter/callback

# -----------------------------------------------------------------------------
# Discord (OAuth + bot token)
# https://discord.com/developers/applications → create app → add bot
# -----------------------------------------------------------------------------
# DISCORD_CLIENT_ID=your-client-id
# DISCORD_CLIENT_SECRET=your-client-secret
# DISCORD_BOT_TOKEN=your-bot-token
# DISCORD_REDIRECT_URI=https://api.yourdomain.com/auth/discord/callback

# -----------------------------------------------------------------------------
# Tumblr
# https://www.tumblr.com/oauth/apps → register app (no review required)
# -----------------------------------------------------------------------------
# TUMBLR_CONSUMER_KEY=your-consumer-key
# TUMBLR_CONSUMER_SECRET=your-consumer-secret
# TUMBLR_REDIRECT_URI=https://api.yourdomain.com/auth/tumblr/callback

# =============================================================================
# Billing — Dodo Payments (leave commented to disable, all features unlocked)
# =============================================================================
# ENABLE_BILLING=true
# DODO_ENV=live_mode
# DODO_API_KEY=your-api-key
# DODO_WEBHOOK_SECRET=your-webhook-secret
# DODO_PRODUCT_CREATOR=your-creator-product-id
# DODO_PRODUCT_PRO=your-pro-product-id
# DODO_PRODUCT_TEAM=your-team-product-id
