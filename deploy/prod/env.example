# /root/posthive/.env — variable names only. Never commit real values.
# The real file is root:root 0600 (gitignored) and lives only on the server.

# --- Generated on the server with `openssl rand -hex 32` --------------------------------------
POSTGRES_PASSWORD=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Protects /admin/run-cleanup, /admin/run-drip, /admin/sync-stats. Empty means they are OPEN.
ADMIN_PIN=
ADMIN_EMAIL=

# --- Preserved from the existing deployment ---------------------------------------------------
# 64 hex chars. Never regenerate once accounts are connected: stored OAuth tokens become unreadable.
ENCRYPTION_KEY=

# --- URLs as seen by the browser (baked into the web image at build time) ---------------------
# Same origin behind Caddy: /api/* is proxied to the API with the prefix stripped.
WEB_URL=https://marketing.playmates.dev
PUBLIC_API_URL=https://marketing.playmates.dev/api

PORT=3001
AUTH_PROVIDER=local
STORAGE_PROVIDER=local
# NODE_ENV=production already forces Secure cookies inside the container; this extra flag is redundant.
SECURE_COOKIES=false
TZ=UTC

# Prisma direct connection (same database here; keep equal to DATABASE_URL's target).
DIRECT_URL=

# Must be defined, even if empty: apps/api/src/routes/auth.ts calls .trim() on them at import.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=https://marketing.playmates.dev/api/auth/instagram/callback

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://marketing.playmates.dev/api/auth/linkedin/callback

# --- Optional ---------------------------------------------------------------------------------
# RESEND_API_KEY=
# EMAIL_FROM=Posthive <noreply@marketing.playmates.dev>
