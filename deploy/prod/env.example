# /opt/posthive/.env — variable names only. Never commit real values.
# The real file is root:root 0600 and is generated on the server (see README.md, "Secrets").

# --- Generated on the server with `openssl rand -hex 32` ---------------------------------------
POSTGRES_PASSWORD=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Protects /admin/run-cleanup, /admin/run-drip, /admin/sync-stats (open when empty).
ADMIN_PIN=

# --- Preserved from the existing deployment ---------------------------------------------------
# 64 hex chars. Never regenerate once accounts are connected: stored OAuth tokens become unreadable.
ENCRYPTION_KEY=

# --- URLs as seen by the browser (also baked into the web image at build time) ----------------
WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:3001

PORT=3001
AUTH_PROVIDER=local
STORAGE_PROVIDER=local

# Must be defined, even if empty: apps/api/src/routes/auth.ts calls .trim() on them at import.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# --- Only once a public HTTPS domain exists (README.md, "Adding a domain") --------------------
# INSTAGRAM_REDIRECT_URI=https://api.<domain>/auth/instagram/callback
# RESEND_API_KEY=
# EMAIL_FROM=Posthive <noreply@<domain>>
